# Publishd — environment
# Copy to .env.local for local dev. On Cloudflare, set via `wrangler secret put <NAME>`.

# Stripe (use LIVE secret for production; test secret for local)
STRIPE_SECRET_KEY=sk_live_xxx_or_sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Groq — help bot (openai/gpt-oss-120b)
GROQ_API_KEY=gsk_xxx

# Optional: destination for intake submissions + chat transcripts
INTAKE_WEBHOOK_URL=

# Public site URL for canonical / OG / Stripe success + cancel
NEXT_PUBLIC_SITE_URL=https://publishd.app

# Segment analytics — Trustpilot review invites flow through the Segment
# `Order Completed` event fired from /api/stripe-webhook. The write key is
# safe to expose (browser analytics.js requires it in the page). Override
# either or both if you rotate the source.
NEXT_PUBLIC_SEGMENT_WRITE_KEY=xX6JHkThZ29NmAnlnA4ruPJJF4N5xgaT
SEGMENT_WRITE_KEY=xX6JHkThZ29NmAnlnA4ruPJJF4N5xgaT

# Trustpilot fallback BCC — use only if Segment integration is ever
# disabled. Not wired into transactional email today because Cloudflare
# Email binding only routes to verified destinations; keep noted for
# manual Stripe-dashboard BCC configuration instead.
TRUSTPILOT_INVITE_BCC=publishd.app+786cb55362@invite.trustpilot.com
